# Fim de linha consistente. Texto normaliza para LF no repositório.
* text=auto eol=lf

# Arquivos que precisam manter CRLF no Windows
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binários (não converter)
*.png binary
*.jpg binary
*.jpeg binary
*.exr binary
*.xlsx binary
*.pck binary
*.zip binary
